# --- Base de datos (Turso) ---
# https://turso.tech → crea una DB → copia URL + auth token
TURSO_DATABASE_URL="libsql://cumple-victor-<username>.turso.io"
TURSO_AUTH_TOKEN=""

# --- Email (Resend) ---
# https://resend.com → API Keys → crea uno
RESEND_API_KEY=""
# Dev: "onboarding@resend.dev" (solo envía a tu email verificado).
# Prod: usa un dominio verificado en Resend.
RESEND_FROM="Cumple Víctor <onboarding@resend.dev>"
# Tu email — dónde te llegan las respuestas
NOTIFY_TO="victor@uvicuo.com"

# --- Admin ---
# Token secreto para /admin?token=... — cambia por algo random y largo
ADMIN_TOKEN="cambia-esto-por-algo-random-y-largo"
